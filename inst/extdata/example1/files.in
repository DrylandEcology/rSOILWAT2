#------ File names for a SOILWAT2 simulation experiment

# List of path names and file names for input and output
# All names are relative to current directory of execution (see option `-d`)
# USER: change path and file names as suitable for own simulation experiment


#--- Files for netCDF-related inputs
Input_nc/SW2_netCDF_input_variables.tsv
Input_nc/desc_nc.in
Input_nc/SW2_netCDF_output_variables.tsv
Input_nc/cached_state.nc
Input_nc/system.in

#--- Spatial and temporal description of simulation experiment
Input/domain.in             # Spatiotemporal simulation domain
Input/modelrun.in           # Note: only useful in txt-mode

#--- Log for warnings and error messages
logs/logfile.log            # Logfile

#--- Description of simulated site
Input/siteparam.in          # Parameters and process options
Input/soils.in              # Soil characterization by soil layer
Input/swrc_params.in        # Soil water retention curve parameters

#--- Inputs of weather forcing and description of climate conditions
Input/weathsetup.in         # Forcing-related parameters and settings
Input/data_weather/weath    # Path that contains historical weather data files
Input/mkv_prob.in           # Weather generator: probability table
Input/mkv_covar.in          # Weather generator: covariance table
Input/climate.in            # Mean monthly atmospheric characterization

#--- Description of vegetation
Input/veg.in                # Land cover and vegetation types
Input/estab.in              # (Optional) plant establishments parameters

#--- Description of CO2 effects
Input/carbon.in             # Yearly atmospheric CO2 concentration

#--- Description of (optional) soil moisture measurements
Input/swcsetup.in           # Settings for observed soil moisture

#--- Simulation outputs
Input/outsetup.in           # Output settings and file names
